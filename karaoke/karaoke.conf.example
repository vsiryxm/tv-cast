# karaoke.conf 配置示例（UTF-8 编码；一行一个 key=value；井号开头是注释）
#
# 这个文件有两处会被读取：
#   1) 构建时：karaoke/karaoke.conf 里白名单的键（台名、欢迎语、台词秒数、直播时间）由 build.sh
#      打进 APK 的 assets/karaoke.conf，作为默认值，改完要重新编译
#   2) 运行时：U 盘根目录的 karaoke.conf 覆盖上面的值，不用重编译，重插 U 盘即生效
#
# 优先级：U 盘配置 > 构建配置 > 内置默认
#        （台名「K歌台」、欢迎语「欢迎来到 <台名>，」、台词最多 30 秒）
# 键名大小写不敏感；等号后直接写文字，不要加引号；值里的 \n 表示换行。
# 文件不存在、写错、读失败都不影响唱歌。

# 台名：启动页、顶栏、跑马灯欢迎语都用它
APP_NAME=K歌台

# 跑马灯欢迎语；不写就自动用「欢迎来到 <台名>，」
welcome=欢迎来到 K歌台，

# 开场台词没有开关：U 盘根目录放一个 karaoke_openings.txt 就显示，删掉就不显示。
# 这个值只是「每首歌最多停几秒」，默认 30；开唱 2 秒后会提前收，至少留 6 秒。
opening_secs=30

# 写 1 = 开唱也不提前收，台词卡一直停到秒数用完（整段开场词要念完时用）。默认 0。
opening_hold=0

# 台词文件格式（karaoke_openings.txt，UTF-8）：
#   ## 02-故乡情 - 程琳
#   故乡的山，故乡的水，走到哪儿都忘不了这条河。
#   ...
# 「## 」后面是歌文件名（不带 .mp3 / .lrc），正文可以写多行，「#」开头是注释。
# 播歌时按遥控器 # 键可以临时收起台词，再按一次恢复。

# ---------- 直播提醒 ----------
# 两个键必须同时存在、都是严格 HH:mm（24 小时制，两位小时 + 半角冒号 + 两位分钟），
# 且结束晚于开始。例如 18:30 / 20:00；写成 18:5、25:00、8:30、18：30 都不合法。
# 任一不合法、缺一个、区间倒置 → 整个提醒功能不触发，也不影响唱歌。
# 生效后：进入直播时段在屏幕右侧中部弹「直播开始啦」，结束前 10 分钟弹「还有 N 分钟」；
# 每天各一次，换一首歌时自动收起（重唱、切原唱/伴奏不算换歌）。
# 时间按电视本机钟点判断（Calendar 取设备时区），不是手机时间。
# 本机电视时区为 Asia/Shanghai，与北京时间一致，直接填 18:30/20:00 即可。
# 排查坑：adb shell date 是 busybox，未设 TZ 时显示 UTC（慢 8 小时），那只是 shell 假象；
# 核对请用 adb shell dumpsys alarm | head -3 里的 now=。不支持跨夜时段。
live_start=18:30
live_end=20:00
